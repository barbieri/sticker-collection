{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2025",
    "noEmit": true,
    "noUncheckedSideEffectImports": false,
    "lib": ["ES2025", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}

{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "**",
      "!.agents",
      "!coverage",
      "!dist",
      "!node_modules",
      "!test-results",
      "!playwright-report"
    ]
  }
}

{
  "name": "sticker-collection",
  "description": "Web Application to manage collection of stickers, duplicates, exchange helper, printable and shareable via SMS, WhatsApp, Clipboard and QRCode",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "run-s build serve",
    "validate:specs": "node scripts/validate-specs.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "qa": "run-s typecheck check test:coverage test:e2e build",
    "serve": "pnpm exec serve dist -l 4173"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "^1.62.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "handlebars": "4.7.10",
    "html-minifier-terser": "^7.2.0",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "npm-run-all": "4.1.5",
    "serve": "14.2.6",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
